# Get a free API key at https://console.groq.com/keys (email signup, no card).
# Without this set, ReasoningAgent runs in rule-based-only mode (works fine,
# just not LLM-driven).
GROQ_API_KEY=

# Optional override. Default is llama-3.3-70b-versatile (1,000 req/day free tier).
# GROQ_MODEL=groq/llama-3.3-70b-versatile
